#  ELECTRIC BILL
# This file is the SINGLE SOURCE OF TRUTH for the configuration.
# Edit THIS FILE, not the deploy scripts.

GCP_PROJECT_ID=first-orc-chien
GCP_REGION=asia-southeast1

IMAGE_URI=asia-southeast1-docker.pkg.dev/first-orc-chien/swift-json-vlm-container-finetuned/inference-bill:latest


# Optimize download speed
USE_HF_TRANSFER=true
HF_HUB_ENABLE_HF_TRANSFER=1

# Image processing parameters
SIZE_FACTOR=8
MAX_PIXELS=602112

# SM_VLLM_* variables are automatically mapped to --xxx flags for vLLM serve
SM_VLLM_DTYPE=bfloat16
SM_VLLM_MAX_MODEL_LEN=38608
SM_VLLM_MAX_NUM_SEQS=8
SM_VLLM_LIMIT_MM_PER_PROMPT=image=2, video=0
SM_VLLM_SERVED_MODEL_NAME=document-to-json
